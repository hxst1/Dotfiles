#!/usr/bin/env python3
"""Portapapeles iPhone → Arch por la red local (sin Tailscale ni servicios externos).

Un Atajo del iPhone hace POST con lo que tengas copiado y aquí acaba en el
portapapeles de Hyprland (wl-copy), con una notificación de lo que llegó.
Nunca pega nada por su cuenta: solo lo deja listo para Ctrl+V.

  POST /clip   cuerpo = texto o imagen  → al portapapeles del Arch
  GET  /clip                            → devuelve el portapapeles del Arch (texto o imagen)

Todas las peticiones llevan la cabecera `X-Clip-Token` con el token de
~/.config/iphone-clip/token. Opcional en ~/.config/iphone-clip/allow: IPs
permitidas, una por línea (vacío o sin archivo = cualquiera de la red local).
"""

import hmac
import ipaddress
import os
import subprocess
import tempfile
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

CONFIG = Path.home() / ".config" / "iphone-clip"
TOKEN = (CONFIG / "token").read_text().strip()
PORT = int(os.environ.get("IPHONE_CLIP_PORT", "7711"))
MAX_BYTES = 25 * 1024 * 1024  # una captura o foto cabe de sobra

# Firmas de imagen por si el Atajo manda application/octet-stream
MAGIC = {
    b"\x89PNG\r\n\x1a\n": "image/png",
    b"\xff\xd8\xff": "image/jpeg",
    b"GIF8": "image/gif",
}


def allowed_ips() -> set[str]:
    path = CONFIG / "allow"
    if not path.exists():
        return set()
    return {line.strip() for line in path.read_text().splitlines() if line.strip() and not line.startswith("#")}


def sniff(data: bytes, declared: str) -> str:
    declared = declared.split(";")[0].strip().lower()
    for magic, mime in MAGIC.items():
        if data.startswith(magic):
            return mime
    if data[4:12] in (b"ftypheic", b"ftypheix", b"ftypmif1", b"ftyphevc"):
        return "image/heic"
    if declared.startswith("image/"):
        return declared
    return "text/plain"


def to_clipboard(data: bytes, mime: str) -> str:
    """Copia y devuelve una descripción corta para la notificación."""
    if mime == "image/heic":
        # Las fotos del iPhone vienen en HEIC y casi ninguna app de Linux lo pega
        with tempfile.NamedTemporaryFile(suffix=".heic") as src:
            src.write(data)
            src.flush()
            data = subprocess.run(["magick", src.name, "png:-"], capture_output=True, check=True).stdout
        mime = "image/png"
    if mime.startswith("image/"):
        subprocess.run(["wl-copy", "--type", mime], input=data, check=True)
        return f"Imagen ({len(data) // 1024} KB)"
    text = data.decode("utf-8", errors="replace")
    subprocess.run(["wl-copy", "--type", "text/plain;charset=utf-8"], input=text.encode(), check=True)
    preview = " ".join(text.split())
    return preview[:120] + ("…" if len(preview) > 120 else "")


def notify(body: str) -> None:
    subprocess.run(
        ["notify-send", "-a", "iPhone", "-i", "edit-paste", "Copiado desde el iPhone", body],
        check=False,
    )


class Handler(BaseHTTPRequestHandler):
    server_version = "iphone-clip"

    def _authorized(self) -> bool:
        ip = self.client_address[0]
        allow = allowed_ips()
        if allow and ip not in allow:
            return False
        if not ipaddress.ip_address(ip).is_private:
            return False
        return hmac.compare_digest(self.headers.get("X-Clip-Token", ""), TOKEN)

    def _reply(self, code: int, body: bytes = b"", mime: str = "text/plain; charset=utf-8") -> None:
        self.send_response(code)
        self.send_header("Content-Type", mime)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if body:
            self.wfile.write(body)

    def do_POST(self) -> None:  # noqa: N802
        if self.path.rstrip("/") != "/clip":
            return self._reply(404)
        if not self._authorized():
            return self._reply(403, b"no\n")
        length = int(self.headers.get("Content-Length", "0"))
        if length <= 0 or length > MAX_BYTES:
            return self._reply(413, b"vacio o demasiado grande\n")
        data = self.rfile.read(length)
        try:
            summary = to_clipboard(data, sniff(data, self.headers.get("Content-Type", "")))
        except subprocess.CalledProcessError:
            return self._reply(500, b"no se pudo copiar\n")
        notify(summary)
        self._reply(200, b"ok\n")

    def do_GET(self) -> None:  # noqa: N802
        if self.path.rstrip("/") != "/clip":
            return self._reply(404)
        if not self._authorized():
            return self._reply(403, b"no\n")
        # Texto si lo hay; si lo copiado es solo una imagen (una captura), la imagen
        types = subprocess.run(["wl-paste", "--list-types"], capture_output=True, text=True).stdout.split()
        image = next((t for t in ("image/png", "image/jpeg") if t in types), None)
        if image and not any(t.startswith("text/") or t in ("UTF8_STRING", "STRING") for t in types):
            out = subprocess.run(["wl-paste", "--type", image], capture_output=True)
            return self._reply(200, out.stdout, image)
        out = subprocess.run(["wl-paste", "--no-newline", "--type", "text"], capture_output=True)
        self._reply(200, out.stdout)

    def log_message(self, fmt: str, *args) -> None:  # al journal, sin el cuerpo
        print(f"{self.client_address[0]} {fmt % args}", flush=True)


if __name__ == "__main__":
    host = os.environ.get("IPHONE_CLIP_HOST", "0.0.0.0")
    ThreadingHTTPServer((host, PORT), Handler).serve_forever()
