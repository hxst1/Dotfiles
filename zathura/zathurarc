# Zathura — tema Niebla
set font "JetBrainsMono Nerd Font 11"
set selection-clipboard clipboard
set adjust-open "best-fit"
set guioptions ""

set default-bg "#141516"
set default-fg "#e4e6e7"
set statusbar-bg "#141516"
set statusbar-fg "#c8ccd0"
set inputbar-bg "#141516"
set inputbar-fg "#e4e6e7"
set notification-bg "#202224"
set notification-fg "#e4e6e7"
set notification-error-bg "#202224"
set notification-error-fg "#b8656a"
set notification-warning-bg "#202224"
set notification-warning-fg "#c4b49a"
set highlight-color "rgba(201,168,212,0.4)"
set highlight-active-color "rgba(179,136,196,0.6)"
set completion-bg "#202224"
set completion-fg "#e4e6e7"
set completion-highlight-bg "#3a3c3f"
set completion-highlight-fg "#c8ccd0"
set index-bg "#141516"
set index-fg "#e4e6e7"
set index-active-bg "#3a3c3f"
set index-active-fg "#c8ccd0"

# Modo recolor (tecla Ctrl+r): documentos en colores del tema
set recolor-lightcolor "#141516"
set recolor-darkcolor "#e4e6e7"
set recolor false
set recolor-keephue true
