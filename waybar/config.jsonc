{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 2,
    // Distribución tipo barra de menús de macOS: una sola barra de cristal,
    // identidad + escritorios a la izquierda, estado + hora a la derecha.
    "modules-left": ["custom/launcher", "custom/workspaces", "hyprland/window"],
    "modules-center": ["mpris"],
    // Los módulos dev (docker/updates/github) solo aparecen si tienen algo que contar
    "modules-right": ["custom/devserver", "custom/docker", "custom/github", "custom/updates", "group/stats", "tray", "custom/presencia", "bluetooth", "pulseaudio", "custom/net", "custom/notification", "clock"],

    "custom/launcher": {
        "format": "\uf303",
        "tooltip": false,
        "on-click": "wofi --show drun",
        "on-click-right": "/home/eya/.local/bin/teclas"
    },
    "hyprland/window": {
        "format": "{class}",
        "max-length": 28,
        "separate-outputs": true,
        "rewrite": {
            "^$": "Escritorio",
            "kitty": "Terminal",
            "dev.zed.Zed": "Zed",
            "google-chrome": "Chrome",
            "thunar": "Archivos",
            "org.pulseaudio.pavucontrol": "Sonido"
        }
    },

    "custom/workspaces": {
        "exec": "/home/eya/.config/waybar/scripts/workspaces-paged.sh",
        "return-type": "json",
        "format": "{}",
        "tooltip": true,
        "on-click": "/home/eya/.config/waybar/scripts/workspaces-paged.sh toggle",
        "on-scroll-up": "/home/eya/.config/waybar/scripts/workspaces-paged.sh next",
        "on-scroll-down": "/home/eya/.config/waybar/scripts/workspaces-paged.sh prev"
    },
    "mpris": {
        "format": "{player_icon}  {title} · {artist}",
        "format-paused": "{status_icon}  {title} · {artist}",
        "max-length": 48,
        "player-icons": { "default": "\uf001", "spotify": "\uf1bc" },
        "status-icons": { "paused": "\uf04c", "playing": "\uf04b" }
    },
    "clock": {
        "format": "{:L%a %d %b   %H:%M}",
        "locale": "es_ES.utf8",
        "on-click": "swaync-client -t -sw",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "group/stats": {
        "orientation": "horizontal",
        // Cajón: solo se ve la CPU; al pasar el ratón se despliegan temp y disco
        "drawer": {
            "transition-duration": 350,
            "children-class": "stat-child",
            "transition-left-to-right": false
        },
        "modules": ["cpu", "memory", "temperature", "disk"]
    },
    "cpu": {
        "format": " {usage}%",
        "interval": 2,
        "tooltip": true,
        "on-click": "/home/eya/.config/hypr/scripts/sysmenu-launch.sh"
    },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C",
        "interval": 2,
        "on-click": "/home/eya/.config/hypr/scripts/sysmenu-launch.sh"
    },
    "disk": {
        "path": "/",
        "format": " {free}",
        "tooltip-format": "Disco {path}: {free} libres de {total} ({percentage_used}% usado)",
        "interval": 30,
        "on-click": "/home/eya/.config/hypr/scripts/sysmenu-launch.sh"
    },
    "custom/devserver": {
        "exec": "/home/eya/.config/waybar/scripts/devserver.sh",
        "return-type": "json",
        "interval": 3,
        "on-click": "/home/eya/.config/waybar/scripts/devserver.sh open",
        "on-click-right": "/home/eya/.config/waybar/scripts/devserver.sh kill"
    },
    "memory": {
        "format": "\udb80\udf5b {percentage}%",
        "interval": 5,
        "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB · swap {swapUsed:0.1f} GiB",
        "on-click": "/home/eya/.config/hypr/scripts/sysmenu-launch.sh"
    },
    "custom/docker": {
        "exec": "/home/eya/.config/waybar/scripts/docker.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "/home/eya/.config/hypr/scripts/panel.sh docker"
    },
    "custom/updates": {
        "exec": "/home/eya/.config/waybar/scripts/updates.sh",
        "return-type": "json",
        "interval": 1800,
        "on-click": "/home/eya/.config/hypr/scripts/panel.sh updates"
    },
    "custom/github": {
        "exec": "/home/eya/.config/waybar/scripts/github.sh",
        "return-type": "json",
        "interval": 300,
        "on-click": "xdg-open https://github.com/notifications"
    },
    "custom/presencia": {
        "exec": "/home/eya/.config/waybar/scripts/presencia.sh",
        "return-type": "json",
        "interval": 30,
        "signal": 9,
        "on-click": "/home/eya/.config/waybar/scripts/presencia.sh toggle"
    },
    "bluetooth": {
        "format": "\udb80\udcaf",
        "format-off": "\udb80\udcb2",
        "format-disabled": "\udb80\udcb2",
        "format-connected": "\udb80\udcb1 {num_connections}",
        "tooltip-format": "{controller_alias} · {status}",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} · {device_battery_percentage}%",
        "on-click": "/home/eya/.config/hypr/scripts/panel.sh bluetooth",
        "on-click-right": "/home/eya/.config/swaync/scripts/toggle.sh bt get | grep -q true && bluetoothctl power off || bluetoothctl power on"
    },
    "custom/net": {
        "exec": "/home/eya/.config/waybar/scripts/netcheck.sh",
        "return-type": "json",
        "interval": 5
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "\uf026  muted",
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "/home/eya/.config/hypr/scripts/panel.sh audio",
        "tooltip-format": "{desc}  \u00b7  {volume}%"
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "\uf0f3",
            "none": "\uf0f3",
            "dnd-notification": "\uf1f6",
            "dnd-none": "\uf1f6"
        },
        "return-type": "json",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "tray": { "spacing": 10, "icon-size": 15 }
}
